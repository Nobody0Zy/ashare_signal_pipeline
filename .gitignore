# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# 运行态产物：数据、模型、输出（仅保留占位与跟踪文件）
# data/raw 的原始数据属于使用者本地资产，默认不提交；
# 如确需随仓库分发小样本，用 git add -f 显式添加。
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep
models/*
!models/.gitkeep
# 实验登记表是跟踪文件，随提交演进
outputs/*
!outputs/experiment_registry.json

# 运行态 state
state/
pipeline_state_*.json
legacy_unversioned/
bagging_regen.log

# 本地验证配置（含机器绝对路径），不入库
configs/local/

# 重构参考模板（外部项目复制而来，仅本地参考，不入库；重构完成后可删除）
version_design/demo/

# v1.1 一次性验收工具的运行期报告（默认写在仓库根）
verify_report*.json
